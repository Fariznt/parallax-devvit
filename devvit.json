{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "policy-agent",
  "permissions": {
    "redis": true
  },
  "blocks": {
    "entry": "src/service/main.ts"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "inline.html"
      },
      "main": {
        "entry": "main.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets"
  },
  "menu": {
    "items": [
      {
        "label": "Moderation Webview",
        "description": "Creates or opens existing moderation webview",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onCommentCreate": "/internal/on-comment-create",
    "onPostCreate": "/internal/on-post-create"
  }
}
